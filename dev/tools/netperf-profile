DSCP_SYMBOLIC_MAP: Dict[str, str] = {
    'CS0': '0x00', 'BE': '0x00', 'DEFAULT': '0x00',
    'CS1': '0x20', 'AF11': '0x28', 'AF12': '0x30', 'AF13': '0x38',
    'CS2': '0x40', 'AF21': '0x48', 'AF22': '0x50', 'AF23': '0x58',
    'CS3': '0x60', 'AF31': '0x68', 'AF32': '0x70', 'AF33': '0x78',
    'CS4': '0x80', 'AF41': '0x88', 'AF42': '0x90', 'AF43': '0x98',
    'CS5': '0xa0', 'EF': '0xb8',
    'CS6': '0xc0', 'CS7': '0xe0',
}


def resolve_tos_value(tos_spec: str) -> str:
    """Convert symbolic DSCP name ('EF', 'AF21', 'CS3'), 'dscp:46', or integer to IP_TOS hex."""
    if not tos_spec:
        return ""
    spec = str(tos_spec).strip()
    if ',' in spec:
        parts = [resolve_tos_value(p) for p in spec.split(',', 1)]
        return f"{parts[0]},{parts[1]}"
    upper = spec.upper()
    if upper in DSCP_SYMBOLIC_MAP:
        return DSCP_SYMBOLIC_MAP[upper]
    if upper.startswith('DSCP:') or upper.startswith('DSCP'):
        num_str = re.sub(r'^DSCP:?', '', upper).strip()
        if num_str.isdigit():
            dscp = int(num_str)
            return f"0x{(dscp & 0x3f) << 2:02x}"
    if upper.startswith('0X'):
        return spec.lower()
    if spec.isdigit():
        val = int(spec)
        if val in (10, 12, 14, 18, 20, 22, 24, 26, 28, 30, 34, 36, 38, 46, 48, 56):
            return f"0x{(val & 0x3f) << 2:02x}"
        return f"0x{val & 0xff:02x}"
    return spec


def _parse_yaml_scalar(val_str: str) -> Any:
    """Parse a scalar YAML value into bool, int, float, list, or str."""
    v = val_str.strip()
    if not v:
        return ""
    if (v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'")):
        return v[1:-1]
    if v.startswith('[') and v.endswith(']'):
        inner = v[1:-1].strip()
        if not inner:
            return []
        return [_parse_yaml_scalar(x) for x in inner.split(',')]
    lower = v.lower()
    if lower in ('true', 'yes'):
        return True
    if lower in ('false', 'no'):
        return False
    if lower in ('null', 'none', '~'):
        return None
    try:
        if '.' in v or 'e' in lower:
            return float(v)
        return int(v)
    except ValueError:
        return v


def _strip_yaml_comment(line: str) -> str:
    """Strip inline YAML comment (# ...) while preserving quoted strings."""
    in_single = False
    in_double = False
    for idx, ch in enumerate(line):
        if ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        elif ch == '#' and not in_single and not in_double:
            if idx == 0 or line[idx - 1].isspace():
                return line[:idx].rstrip()
    return line.rstrip()


def _parse_simple_yaml(content: str) -> Dict[str, Any]:
    """Minimal stdlib YAML parser supporting nested dicts and lists of dicts/scalars."""
    cleaned_lines: List[Tuple[int, str]] = []
    for raw_line in content.splitlines():
        stripped_comment = _strip_yaml_comment(raw_line)
        if not stripped_comment.strip():
            continue
        indent = len(stripped_comment) - len(stripped_comment.lstrip(' '))
        cleaned_lines.append((indent, stripped_comment.strip()))

    def parse_block(idx: int, min_indent: int) -> Tuple[Any, int]:
        if idx >= len(cleaned_lines):
            return {}, idx
        first_indent, first_text = cleaned_lines[idx]
        if first_indent < min_indent:
            return {}, idx

        if first_text.startswith('- ') or first_text == '-':
            items: List[Any] = []
            list_indent = first_indent
            while idx < len(cleaned_lines):
                cur_indent, cur_text = cleaned_lines[idx]
                if cur_indent < list_indent:
                    break
                if cur_indent != list_indent or not (cur_text.startswith('- ') or cur_text == '-'):
                    break
                after_dash = cur_text[1:].strip()
                idx += 1
                if not after_dash:
                    sub_val, idx = parse_block(idx, list_indent + 1)
                    items.append(sub_val)
                elif ':' in after_dash and not (after_dash.startswith('"') or after_dash.startswith("'")):
                    k, v_raw = after_dash.split(':', 1)
                    item_dict: Dict[str, Any] = {}
                    v_str = v_raw.strip()
                    if v_str:
                        item_dict[k.strip()] = _parse_yaml_scalar(v_str)
                    else:
                        sub_val, idx = parse_block(idx, list_indent + 1)
                        item_dict[k.strip()] = sub_val
                    # Read additional keys belonging to this list item dict
                    while idx < len(cleaned_lines):
                        next_indent, next_text = cleaned_lines[idx]
                        if next_indent <= list_indent:
                            break
                        if next_text.startswith('- '):
                            break
                        if ':' in next_text:
                            nk, nv_raw = next_text.split(':', 1)
                            nv_str = nv_raw.strip()
                            idx += 1
                            if nv_str:
                                item_dict[nk.strip()] = _parse_yaml_scalar(nv_str)
                            else:
                                sub_val, idx = parse_block(idx, next_indent + 1)
                                item_dict[nk.strip()] = sub_val
                        else:
                            idx += 1
                    items.append(item_dict)
                else:
                    items.append(_parse_yaml_scalar(after_dash))
            return items, idx

        mapping: Dict[str, Any] = {}
        map_indent = first_indent
        while idx < len(cleaned_lines):
            cur_indent, cur_text = cleaned_lines[idx]
            if cur_indent < map_indent:
                break
            if cur_text.startswith('- '):
                break
            if ':' in cur_text:
                k, v_raw = cur_text.split(':', 1)
                key = k.strip()
                v_str = v_raw.strip()
                idx += 1
                if v_str:
                    mapping[key] = _parse_yaml_scalar(v_str)
                else:
                    sub_val, idx = parse_block(idx, cur_indent + 1)
                    mapping[key] = sub_val
            else:
                idx += 1
        return mapping, idx

    parsed, _ = parse_block(0, 0)
    return parsed if isinstance(parsed, dict) else {}


class ProfileValidator:
    """Validate profile definitions."""

    REQUIRED_FIELDS = ['name', 'description', 'version', 'tests']
    REQUIRED_TEST_FIELDS = ['name', 'direction', 'protocol']
    VALID_DIRECTIONS = [
        'send', 'recv', 'rr', 'stream', 'maerts',
        'tx', 'rx', 'bx', 'bx-seq', 'bidirectional'
    ]
    VALID_PROTOCOLS = ['tcp', 'udp', 'sctp', 'sdp', 'dccp', 'udplite']

    @staticmethod
    def validate(profile: Dict[str, Any]) -> Tuple[bool, List[str]]:
        """Validate profile structure and content."""
        errors: List[str] = []

        for field in ProfileValidator.REQUIRED_FIELDS:
            if field not in profile:
                errors.append(f"Missing required field: {field}")

        if 'tests' in profile:
            if not isinstance(profile['tests'], list):
                errors.append("'tests' must be a list")
            elif len(profile['tests']) == 0:
                errors.append("'tests' list is empty")
            else:
                for i, test in enumerate(profile['tests']):
                    errors.extend(ProfileValidator._validate_test(test, i))

        if 'global' in profile:
            errors.extend(ProfileValidator._validate_global(profile['global']))

        return (len(errors) == 0, errors)

    @staticmethod
    def _validate_test(test: Dict[str, Any], index: int) -> List[str]:
        errors: List[str] = []
        prefix = f"Test {index}"

        for field in ProfileValidator.REQUIRED_TEST_FIELDS:
            if field not in test:
                errors.append(f"{prefix}: Missing required field '{field}'")

        if 'direction' in test:
            if str(test['direction']).lower() not in ProfileValidator.VALID_DIRECTIONS:
                errors.append(
                    f"{prefix}: Invalid direction '{test['direction']}'. "
                    f"Must be one of: {ProfileValidator.VALID_DIRECTIONS}"
                )

        if 'protocol' in test:
            if str(test['protocol']).lower() not in ProfileValidator.VALID_PROTOCOLS:
                errors.append(
                    f"{prefix}: Invalid protocol '{test['protocol']}'. "
                    f"Must be one of: {ProfileValidator.VALID_PROTOCOLS}"
                )

        numeric_fields = [
            'duration', 'instances', 'socket_size', 'message_size',
            'request_size', 'response_size', 'burst', 'pacing_rate'
        ]
        for field in numeric_fields:
            if field in test:
                if not isinstance(test[field], (int, float)) or test[field] <= 0:
                    errors.append(f"{prefix}: '{field}' must be a positive number")

        return errors

    @staticmethod
    def _validate_global(global_settings: Dict[str, Any]) -> List[str]:
        errors: List[str] = []

        if 'duration' in global_settings:
            if not isinstance(global_settings['duration'], (int, float)) or global_settings['duration'] <= 0:
                errors.append("Global: 'duration' must be a positive number")

        if 'output_format' in global_settings:
            valid_formats = ['json', 'csv', 'keyval', 'human']
            if global_settings['output_format'] not in valid_formats:
                errors.append(f"Global: Invalid output_format. Must be one of: {valid_formats}")

        return errors


class ProfileLoader:
    """Load and parse profile files."""

    @staticmethod
    def load_file(filepath: Path) -> Dict[str, Any]:
        if not filepath.exists():
            raise FileNotFoundError(f"Profile file not found: {filepath}")

        content = filepath.read_text(encoding='utf-8')

        if filepath.suffix == '.json':
            return json.loads(content)
        elif HAS_YAML and filepath.suffix in ['.yaml', '.yml']:
            return yaml.safe_load(content)
        elif filepath.suffix in ['.yaml', '.yml']:
            return _parse_simple_yaml(content)
        elif HAS_YAML:
            return yaml.safe_load(content)
        else:
            try:
                return json.loads(content)
            except json.JSONDecodeError:
                return _parse_simple_yaml(content)

    @staticmethod
    def find_builtin_profile(name: str) -> Optional[Path]:
        script_dir = Path(__file__).parent
        profiles_dir = script_dir.parent / 'profiles'

        for ext in ('.yaml', '.yml', '.json'):
            profile_path = profiles_dir / f"{name}{ext}"
            if profile_path.exists():
                return profile_path
        return None

    @staticmethod
    def list_builtin_profiles() -> List[Tuple[str, Path]]:
        script_dir = Path(__file__).parent
        profiles_dir = script_dir.parent / 'profiles'

        if not profiles_dir.exists():
            return []

        profiles: List[Tuple[str, Path]] = []
        seen = set()
        for ext in ('*.yaml', '*.yml', '*.json'):
            for filepath in sorted(profiles_dir.glob(ext)):
                if filepath.stem not in seen:
                    profiles.append((filepath.stem, filepath))
                    seen.add(filepath.stem)
        return sorted(profiles)


class ProfileRunner:
    """Execute profile tests."""

    DIRECTION_TO_OMNI = {
        'send': 'stream',
        'stream': 'stream',
        'tx': 'stream',
        'recv': 'maerts',
        'maerts': 'maerts',
        'rx': 'maerts',
        'rr': 'rr',
    }

    DIRECTION_TO_MULTI = {
        'send': 'tx',
        'stream': 'tx',
        'tx': 'tx',
        'recv': 'rx',
        'maerts': 'rx',
        'rx': 'rx',
        'bx': 'bx',
        'bidirectional': 'bx',
        'bx-seq': 'bx-seq',
        'rr': 'tx',
    }

    def __init__(self, profile: Dict[str, Any], host: str, netperf_path: str = 'netperf',
                 dry_run: bool = False, verbose: bool = False):
        self.profile = profile
        self.host = host
        self.netperf_path = netperf_path
        self.dry_run = dry_run
        self.verbose = verbose
        self.results: List[Dict[str, Any]] = []
        self.global_settings = profile.get('global', {})

    def run(self) -> bool:
        print(f"\n{'='*70}")
        print(f"Profile:     {self.profile['name']}")
        print(f"Description: {self.profile['description']}")
        print(f"Version:     {self.profile['version']}")
        print(f"Target Host: {self.host}")
        print(f"{'='*70}\n")

        tests = self.profile.get('tests', [])
        total_tests = len(tests)

        for i, test in enumerate(tests, 1):
            print(f"\n[{i}/{total_tests}] Running: {test['name']}")
            print(f"  Description: {test.get('description', 'N/A')}")

            success = self._run_test(test)

            if not success and not self.global_settings.get('continue_on_error', True):
                print("\nStopping profile execution due to test failure", file=sys.stderr)
                return False

        self._print_summary()
        return True

    def _run_test(self, test: Dict[str, Any]) -> bool:
        duration = int(test.get('duration', self.global_settings.get('duration', 10)))
        output_format = test.get('output_format', self.global_settings.get('output_format', 'keyval'))
        warmup = int(test.get('warmup', self.global_settings.get('warmup', 0)))
        instances = int(test.get('instances', 1))
        raw_dir = str(test.get('direction', 'stream')).lower()

        # Use netperf-multi whenever instances > 1 OR when running bidirectional (bx / bx-seq) or multi-port
        if (
            instances > 1
            or raw_dir in ('bx', 'bx-seq', 'bidirectional')
            or test.get('interfaces')
            or self.global_settings.get('interfaces')
            or ',' in self.host
            or '..' in self.host
        ):
            cmd = self._build_multi_command(test, duration, output_format)
        else:
            cmd = self._build_netperf_command(test, duration, output_format)

        if self.verbose or self.dry_run:
            print(f"  Command: {' '.join(cmd)}")

        if self.dry_run:
            print("  [DRY RUN] Skipping execution")
            return True

        if warmup > 0:
            print(f"  Warming up ({warmup}s)...")
            time.sleep(warmup)

        try:
            start_time = time.time()
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=duration * 2 + 60)
            elapsed = time.time() - start_time

            if result.returncode == 0:
                print(f"  ✓ Completed in {elapsed:.1f}s")
                self.results.append({
                    'test': test['name'],
                    'success': True,
                    'duration': elapsed,
                    'output': result.stdout
                })
                return True
            else:
                print(f"  ✗ Failed (exit code {result.returncode})")
                if self.verbose:
                    print(f"  Error: {result.stderr}")
                self.results.append({
                    'test': test['name'],
                    'success': False,
                    'error': result.stderr
                })
                return False

        except subprocess.TimeoutExpired:
            print(f"  ✗ Timeout after {duration * 2 + 60}s")
            return False
        except Exception as e:
            print(f"  ✗ Error: {e}")
            return False

    def _build_netperf_command(self, test: Dict[str, Any], duration: int,
                               output_format: str) -> List[str]:
        """Build single-instance netperf command with valid global (-M) and OMNI (-- -J/-k/-o) flags."""
        target_host = test.get('host', self.host)
        cmd: List[str] = [self.netperf_path]
        cmd.extend(['-H', str(target_host)])
        cmd.append('-M')  # Enable OMNI mode globally
        cmd.extend(['-l', str(duration)])

        selected_cpu: Optional[str] = None
        if 'cpu' in test:
            selected_cpu = str(test['cpu'])
        elif test.get('cpu_affinity', self.global_settings.get('cpu_affinity', False)):
            topo = TopologyAnalyzer.discover_local()
            cores = TopologyAnalyzer.allocate_flow_cores(topo, num_flows=1)
            if cores:
                selected_cpu = str(cores[0])

        if 'control_port' in test:
            cmd.extend(['-p', str(test['control_port'])])
        elif test.get('per_core_netserver', self.global_settings.get('per_core_netserver', False)):
            base_port = int(test.get('base_port', self.global_settings.get('base_port', 18600)))
            lp_cpu = 0
            if selected_cpu:
                parts = selected_cpu.split(',')
                try:
                    lp_cpu = int(parts[-1].strip())
                except ValueError:
                    lp_cpu = 0
            cmd.extend(['-p', str(base_port + lp_cpu)])

        # DSCP / ToS marking (-Y before --)
        dscp = test.get('dscp') or test.get('tos') or self.global_settings.get('dscp')
        if dscp:
            first_dscp = str(dscp[0] if isinstance(dscp, list) else str(dscp).split(',')[0]).strip()
            resolved_dscp = resolve_tos_value(first_dscp)
            cmd.extend(['-Y', f"{resolved_dscp},{resolved_dscp}" if ',' not in resolved_dscp else resolved_dscp])

        # Explicit CPU core binding (-T before --)
        if selected_cpu is not None:
            cmd.extend(['-T', selected_cpu])

        # Test-specific OMNI options (MUST be after --)
        cmd.append('--')

        raw_dir = str(test['direction']).lower()
        omni_dir = self.DIRECTION_TO_OMNI.get(raw_dir, raw_dir)
        cmd.extend(['-d', omni_dir])

        protocol = str(test['protocol']).upper()
        cmd.extend(['-T', protocol])

        # Output mode flag (in nettest_omni.c: -J=JSON, -o=CSV, -k=KEYVAL, -O=HUMAN)
        if output_format == 'json':
            cmd.append('-J')
        elif output_format == 'csv':
            cmd.append('-o')
        elif output_format == 'keyval':
            cmd.append('-k')
        elif output_format == 'human':
            cmd.append('-O')

        if test.get('connection', False):
            cmd.append('-c')

        if test.get('nodelay', self.global_settings.get('nodelay', False)):
            cmd.append('-D')

        if 'socket_size' in test:
            cmd.extend(['-s', str(test['socket_size'])])
            cmd.extend(['-S', str(test['socket_size'])])

        if 'message_size' in test:
            cmd.extend(['-m', str(test['message_size'])])

        if 'request_size' in test and 'response_size' in test:
            cmd.extend(['-r', f"{test['request_size']},{test['response_size']}"])

        if 'burst' in test:
            cmd.extend(['-b', str(test['burst'])])

        if 'pacing_rate' in test:
            cmd.extend(['-q', str(int(test['pacing_rate']))])

        if test.get('zerocopy', False):
            cmd.append('-Z')

        return cmd

    def _build_multi_command(self, test: Dict[str, Any], duration: int,
                             output_format: str) -> List[str]:
        """Build netperf-multi command for parallel, multi-port, or bidirectional tests."""
        script_dir = Path(__file__).parent
        multi_tool = script_dir / 'netperf-multi'
        target_host = test.get('host', self.host)
        raw_dir = str(test['direction']).lower()
        multi_dir = self.DIRECTION_TO_MULTI.get(raw_dir, 'tx')

        cmd: List[str] = [sys.executable, str(multi_tool)]
        cmd.extend(['-H', str(target_host)])
        cmd.extend(['-n', str(test.get('instances', 1))])
        cmd.extend(['-t', 'OMNI'])
        cmd.extend(['-d', multi_dir])
        cmd.extend(['-l', str(duration)])
        cmd.extend(['-o', output_format])

        if self.netperf_path and self.netperf_path != 'netperf':
            cmd.extend(['--netperf', self.netperf_path])

        interfaces = test.get('interfaces') or self.global_settings.get('interfaces')
        if interfaces:
            if isinstance(interfaces, list):
                interfaces = ','.join(str(x) for x in interfaces)
            cmd.extend(['-i', str(interfaces)])

        dscp = test.get('dscp') or test.get('tos') or self.global_settings.get('dscp')
        if dscp:
            if isinstance(dscp, list):
                dscp = ','.join(str(x) for x in dscp)
            cmd.extend(['--dscp', str(dscp)])

        mtu = test.get('mtu') if test.get('mtu') is not None else self.global_settings.get('mtu')
        if mtu is not None:
            cmd.extend(['--mtu', str(mtu)])

        if test.get('cpu_affinity', self.global_settings.get('cpu_affinity', False)):
            cmd.append('--affinity')

        layout = test.get('layout') or self.global_settings.get('layout')
        if layout:
            cmd.extend(['--layout', str(layout)])

        if test.get('per_core_netserver', self.global_settings.get('per_core_netserver', False)):
            cmd.append('--per-core-netserver')

        base_port = test.get('base_port') if test.get('base_port') is not None else self.global_settings.get('base_port')
        if base_port is not None:
            cmd.extend(['--base-port', str(base_port)])

        lp_start_cpu = test.get('lp_start_cpu') if test.get('lp_start_cpu') is not None else self.global_settings.get('lp_start_cpu')
        if lp_start_cpu is not None:
            cmd.extend(['--lp-start-cpu', str(lp_start_cpu)])

        if test.get('stagger_start'):
            cmd.extend(['--stagger', str(test['stagger_start'])])

        if self.verbose:
            cmd.append('-v')

        # Test-specific OMNI options passed after '--'
        cmd.append('--')
        if raw_dir == 'rr':
            cmd.extend(['-d', 'rr'])
        cmd.extend(['-T', str(test['protocol']).upper()])

        if test.get('connection', False):
            cmd.append('-c')

        if test.get('nodelay', self.global_settings.get('nodelay', False)):
            cmd.append('-D')

        if 'socket_size' in test:
            cmd.extend(['-s', str(test['socket_size'])])
            cmd.extend(['-S', str(test['socket_size'])])

        if 'message_size' in test:
            cmd.extend(['-m', str(test['message_size'])])

        if 'request_size' in test and 'response_size' in test:
            cmd.extend(['-r', f"{test['request_size']},{test['response_size']}"])

        if 'burst' in test:
            cmd.extend(['-b', str(test['burst'])])

        if 'pacing_rate' in test:
            cmd.extend(['-q', str(int(test['pacing_rate']))])

        if test.get('zerocopy', False):
            cmd.append('-Z')

        return cmd

    def _print_summary(self) -> None:
        print(f"\n{'='*70}")
        print("Profile Execution Summary")
        print(f"{'='*70}")

        total = len(self.results)
        successful = sum(1 for r in self.results if r.get('success', False))
        failed = total - successful

        print(f"Total Tests:     {total}")
        print(f"Successful:      {successful}")
        print(f"Failed:          {failed}")
        print(f"Success Rate:    {(successful/total*100):.1f}%" if total > 0 else "N/A")
        print(f"{'='*70}\n")

        if failed > 0:
            print("Failed Tests:")
            for result in self.results:
                if not result.get('success', False):
                    print(f"  - {result['test']}")
            print()


def list_profiles() -> None:
    profiles = ProfileLoader.list_builtin_profiles()
    if not profiles:
        print("No built-in profiles found")
        return

    print("\n  Available Profiles:\n")
    print(f"{'='*70}")

    for name, filepath in profiles:
        try:
            profile = ProfileLoader.load_file(filepath)
            desc = profile.get('description', 'No description')
            category = profile.get('category', 'unknown')
            num_tests = len(profile.get('tests', []))

            print(f"  {name:28s} [{category}]")
            print(f"    {desc}")
            print(f"    Tests: {num_tests}")
            print()
        except Exception as e:
            print(f"  {name:28s} [ERROR: {e}]")
            print()

    print(f"{'='*70}\n")


def main() -> int:
    parser = argparse.ArgumentParser(
        description='Profile-based netperf test runner (10G to 800G & Xeon 6 ready)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s --list
  %(prog)s -H 192.168.10.2 -p 200g-ecore
  %(prog)s -H 192.168.10.2 -p 200g-pcore --validate
  %(prog)s -H 192.168.10.2 --profile-file custom.yaml
  %(prog)s -H 192.168.10.2 -p ocp-8x25g-lag-qos --dry-run
        """
    )

    profile_group = parser.add_mutually_exclusive_group(required=False)
    profile_group.add_argument('-p', '--profile', metavar='NAME',
                               help='Built-in profile name')
    profile_group.add_argument('--profile-file', metavar='FILE',
                               help='Path to custom profile file')
    profile_group.add_argument('--list', action='store_true',
                               help='List available built-in profiles')

    parser.add_argument('-H', '--host',
                        help='Target netserver host(s) (required unless --list or --validate)')
    parser.add_argument('--validate', action='store_true',
                        help='Validate profile without execution')
    parser.add_argument('--dry-run', action='store_true',
                        help='Show commands without execution')
    parser.add_argument('--netperf', dest='netperf_path', default='netperf',
                        help='Path to netperf binary')
    parser.add_argument('-o', '--export', '--save-results', dest='save_results', metavar='FILE',
                        help='Export profile execution results to JSON file')
    parser.add_argument('-v', '--verbose', action='store_true',
                        help='Verbose output')
    parser.add_argument('--version', action='version', version='%(prog)s 2.0.0')

    args = parser.parse_args()

    if args.list:
        list_profiles()
        return 0

    if not args.host and not args.validate:
        parser.error("--host is required (unless --list or --validate)")

    if not args.profile and not args.profile_file:
        parser.error("either --profile or --profile-file is required")

    try:
        if args.profile:
            profile_path = ProfileLoader.find_builtin_profile(args.profile)
            if not profile_path:
                print(f"Error: Profile '{args.profile}' not found", file=sys.stderr)
                print("Run with --list to see available profiles", file=sys.stderr)
                return 1
        else:
            profile_path = Path(args.profile_file)

        if args.verbose:
            print(f"Loading profile: {profile_path}")

        profile = ProfileLoader.load_file(profile_path)
    except Exception as e:
        print(f"Error loading profile: {e}", file=sys.stderr)
        return 1

    is_valid, errors = ProfileValidator.validate(profile)
    if not is_valid:
        print("Profile validation failed:", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        return 1

    if args.validate:
        print(f"✓ Profile '{profile['name']}' is valid")
        print(f"  Tests: {len(profile['tests'])}")
        return 0

    runner = ProfileRunner(
        profile=profile,
        host=args.host or '127.0.0.1',
        netperf_path=args.netperf_path,
        dry_run=args.dry_run,
        verbose=args.verbose
    )
    success = runner.run()
    if getattr(args, 'save_results', None):
        Path(args.save_results).write_text(json.dumps({
            'profile': profile.get('name'),
            'host': args.host or '127.0.0.1',
            'results': runner.results,
        }, indent=2), encoding='utf-8')
    return 0 if success else 1


if __name__ == '__main__':
    sys.exit(main())
