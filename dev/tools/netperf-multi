#!/usr/bin/env python3
"""
netperf-multi - Multi-Instance, Multi-Port & Directional Netperf Test Runner

Coordinates multiple netperf instances running in parallel across 1 to 8+ ports
with topology-aware CPU/NUMA affinity (Intel Xeon 6 E-core L2 spread_step2 and
P-core sequential), per-core Load Partner (LP) netserver port binding, TX/RX/BX
directional modes, DSCP/ToS QoS marking, and aggregated statistics.

Usage:
    netperf-multi -H HOST -n INSTANCES [options]

Examples:
    # Run 8 parallel OMNI TX tests with Xeon 6 topology-aware affinity
    netperf-multi -H 192.168.10.2 -n 8 -i ens7np0 --affinity --per-core-netserver

    # Run concurrent bidirectional (BX = 8 TX + 8 RX on disjoint cores)
    netperf-multi -H 192.168.10.2 -n 8 --direction bx -i ens7np0 --affinity

    # Run across 3x200GbE ports simultaneously (8 flows per port = 24 flows)
    netperf-multi -H 192.168.10.2,192.168.20.2,192.168.21.2 \
                  -i ens7np0,ens23np0,ens27np0 -n 8 --direction bx --affinity

    # Run 8-port OCP breakout with DSCP prioritization (EF, CS3, AF21, CS0)
    netperf-multi -H 192.168.10..17.74 -n 4 --dscp EF,CS3,AF21,CS0

Author: Netperf Modernization Project
License: MIT
Version: 2.0.0
"""

